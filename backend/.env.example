CHAT_ENCRYPTION_KEY=replace_with_a_long_random_secret

# Signs session tokens returned by /api/login. Admin routes reject any request
# without a valid one, so set this to a long random value. If it is left unset
# the backend falls back to CHAT_ENCRYPTION_KEY and warns at start-up, but a
# value that is committed or guessable means anyone can mint an admin token.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace_with_another_long_random_secret

# How long a session token stays valid, in milliseconds. Default 12 hours.
SESSION_TTL_MS=43200000

# Railway MySQL can be connected with either MYSQL_URL or the component variables.
# In Railway, set MYSQL_URL to a reference like: ${{MySQL.MYSQL_URL}}
#
# A database password is REQUIRED. It is read from DB_PASSWORD, MYSQLPASSWORD, or
# the password inside MYSQL_URL / DATABASE_URL, and there is deliberately no
# fallback: the backend refuses to start without one rather than quietly using a
# credential from the source. So make sure the URL above has a real password, and
# that it is not the placeholder below.
MYSQL_URL=mysql://root:CHANGE_ME@localhost:3306/jen_academia
# DB_PASSWORD=your-database-password

# Optional: mount a Railway volume here to persist uploaded files.
UPLOAD_ROOT=/app/uploads
DB_CONNECTION_LIMIT=5

# Optional: email sending via Resend (https://resend.com)
FRONTEND_BASE_URL=http://localhost:5173
ACCOUNT_INVITE_EXPIRY_HOURS=24
RESEND_API_KEY=
SMTP_FROM_NAME=JEN Academia

# Optional: class recordings are stored in Google Drive (service account) instead of the backend.
# When set, uploaded recordings are pushed to Drive and served via Drive links.
# Create a service account in Google Cloud, enable the Drive API, and share a Drive folder with the
# service account email (Give this folder access to <CLIENT_EMAIL>). Put the folder ID here.
GOOGLE_DRIVE_CLIENT_EMAIL=
GOOGLE_DRIVE_PRIVATE_KEY=
GOOGLE_DRIVE_FOLDER_ID=

# Optional: auto-fill a teacher's AI Matching Profile from an uploaded resume
# (PDF/DOCX/TXT) on the Create Teacher form. Get a key at
# https://aistudio.google.com/apikey - the free tier is enough. When this is
# blank the upload box reports that auto-fill is not configured.
GOOGLE_GEMINI_API_KEY=
# Bare model id, no "models/" prefix - a prefix is tolerated but a wrong id is
# not. Leave this blank to use the backend's default, which is the better
# default to leave blank: if the configured model is retired, renamed or not
# available to your key, the backend falls back through several current models
# before giving up, so a stale value here costs you a round trip rather than
# every request. Setting it is only worth it if you have a reason.
GEMINI_MODEL=

# Per-client cap on resume uploads, since each one costs a Gemini call.
# Defaults to 10 uploads per 10 minutes per client address. Best effort only:
# behind Railway's edge one browser can land in several address buckets.
RESUME_PARSE_RATE_WINDOW_MS=600000
RESUME_PARSE_RATE_MAX=10

# Global ceiling on resume uploads, which is what actually bounds Gemini spend.
# Defaults to 60 uploads per hour across everyone.
RESUME_PARSE_RATE_TOTAL_WINDOW_MS=3600000
RESUME_PARSE_RATE_TOTAL_MAX=60

# Sign-in attempts per network address. Keep this high: a campus shares one
# NAT address, so students signing in together must not be locked out.
LOGIN_RATE_WINDOW_MS=900000
LOGIN_RATE_MAX=100
