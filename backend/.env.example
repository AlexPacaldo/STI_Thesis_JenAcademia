CHAT_ENCRYPTION_KEY=replace_with_a_long_random_secret

# Signs session tokens returned by /api/login. Admin routes reject any request
# without a valid one, so set this to a long random value. If it is left unset
# the backend falls back to CHAT_ENCRYPTION_KEY and warns at start-up, but a
# value that is committed or guessable means anyone can mint an admin token.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace_with_another_long_random_secret

# How long a session token stays valid, in milliseconds. Default 12 hours.
SESSION_TTL_MS=43200000

# Railway MySQL can be connected with either MYSQL_URL or the component variables.
# In Railway, set MYSQL_URL to a reference like: ${{MySQL.MYSQL_URL}}
#
# A database password is REQUIRED. It is read from DB_PASSWORD, MYSQLPASSWORD, or
# the password inside MYSQL_URL / DATABASE_URL, and there is deliberately no
# fallback: the backend refuses to start without one rather than quietly using a
# credential from the source. So make sure the URL above has a real password, and
# that it is not the placeholder below.
MYSQL_URL=mysql://root:CHANGE_ME@localhost:3306/jen_academia
# DB_PASSWORD=your-database-password

# Optional: mount a Railway volume here to persist uploaded files.
UPLOAD_ROOT=/app/uploads
DB_CONNECTION_LIMIT=5

# Which websites may call this API.
#
# The list always includes the custom domain (https://jenacademia.com and its
# www form), the old Vercel deployment, and http://localhost:5173 for local
# development.
#
# CORS_ORIGINS adds MORE origins to that list, comma separated. It does not
# replace it - setting it for one new domain must not remove the domain the
# site is actually served from.
#
# The list is printed at start-up:
#
#   [cors] Allowed origins: https://jenacademia.com, ...
#
# An origin that is not on the list is refused BY THE BROWSER, with nothing
# on the server to show for it. The visitor sees "Failed to fetch" and the
# developer sees a CORS error in the console.
CORS_ORIGINS=

# Email sending.
#
# The app sends three emails: an account setup invite, a password reset link,
# and a message from the contact form. All three go through the settings
# below.
#
# THERE ARE TWO WAYS TO SEND, AND ONLY ONE OF THEM WORKS EVERYWHERE.
#
# SMTP talks to a mail server on port 587 or 465. Railway blocks both of
# those ports below the Pro plan - the block drops packets instead of
# refusing them, so the connection hangs until it times out - so SMTP on
# Railway means "email is broken" unless the plan allows it.
#
# The HTTPS mail API goes out on port 443 like every other request the app
# makes, and works on every plan. It needs an account with a provider and a
# sending domain that has been verified with them.
#
# MAIL_TRANSPORT  which one to use: "auto" (the default), "api" or "smtp".
#                 "auto" uses the mail API when it is set up and SMTP
#                 otherwise.
#
# --- the HTTPS mail API ---
# MAIL_API_PROVIDER  resend or postmark
# MAIL_API_KEY       the API key from the provider
# MAIL_API_FROM      the address the mail is sent from. The provider only
#                    sends it once the domain has been verified with them.
#                    Defaults to SMTP_FROM, then SMTP_USER.
# MAIL_API_FROM_NAME the name the recipient sees. Defaults to "JEN Academia".
# MAIL_API_URL       optional: override the provider's endpoint. Leave blank.
#
# --- SMTP ---
# SMTP_HOST     the mail server, e.g. smtp.gmail.com or smtp.office365.com
# SMTP_PORT     587 for STARTTLS (the usual), 465 for implicit TLS
# SMTP_SECURE   true for implicit TLS. Leave blank for STARTTLS on 587.
# SMTP_USER     the account the mail is sent from - usually a full email address
# SMTP_PASS     the password or app password for that account
# SMTP_FROM     the address the mail is sent from. Defaults to SMTP_USER.
# SMTP_FROM_NAME the name the recipient sees. Defaults to "JEN Academia".
# SMTP_EHLO_DOMAIN  optional: the domain to greet the server with. Some hosts
#                   need it to match the domain their certificate is for.
#
# Gmail needs an APP PASSWORD, not the account password: turn on 2-Step
# Verification, then create one at myaccount.google.com/apppasswords.
FRONTEND_BASE_URL=http://localhost:5173
ACCOUNT_INVITE_EXPIRY_HOURS=24

MAIL_TRANSPORT=auto
MAIL_API_PROVIDER=resend
MAIL_API_KEY=
MAIL_API_FROM=
MAIL_API_FROM_NAME=JEN Academia
MAIL_API_URL=

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=JEN Academia

# Where the contact form sends its messages. Defaults to the address the
# website publishes as "Email us".
CONTACT_FORM_TO=jenacademia@gmail.com

# Development only: send EVERY email to this address instead of to the
# person it is addressed to. The message keeps a [DEV] marker and the
# original recipient, so a redirected message is never mistaken for a real
# one. LEAVE THIS BLANK on a real server - the server warns loudly at
# start-up when it is set.
SMTP_REDIRECT_TO=

# Optional: class recordings are stored in Google Drive (service account) instead of the backend.
# When set, uploaded recordings are pushed to Drive and served via Drive links.
# Create a service account in Google Cloud, enable the Drive API, and share a Drive folder with the
# service account email (Give this folder access to <CLIENT_EMAIL>). Put the folder ID here.
GOOGLE_DRIVE_CLIENT_EMAIL=
GOOGLE_DRIVE_PRIVATE_KEY=
GOOGLE_DRIVE_FOLDER_ID=

# Optional: auto-fill a teacher's AI Matching Profile from an uploaded resume
# (PDF/DOCX/TXT) on the Create Teacher form. Get a key at
# https://aistudio.google.com/apikey - the free tier is enough. When this is
# blank the upload box reports that auto-fill is not configured.
GOOGLE_GEMINI_API_KEY=
# Bare model id, no "models/" prefix - a prefix is tolerated but a wrong id is
# not. Leave this blank to use the backend's default, which is the better
# default to leave blank: if the configured model is retired, renamed or not
# available to your key, the backend falls back through several current models
# before giving up, so a stale value here costs you a round trip rather than
# every request. Setting it is only worth it if you have a reason.
GEMINI_MODEL=

# Per-client cap on resume uploads, since each one costs a Gemini call.
# Defaults to 10 uploads per 10 minutes per client address. Best effort only:
# behind Railway's edge one browser can land in several address buckets.
RESUME_PARSE_RATE_WINDOW_MS=600000
RESUME_PARSE_RATE_MAX=10

# Global ceiling on resume uploads, which is what actually bounds Gemini spend.
# Defaults to 60 uploads per hour across everyone.
RESUME_PARSE_RATE_TOTAL_WINDOW_MS=3600000
RESUME_PARSE_RATE_TOTAL_MAX=60

# Sign-in attempts per network address. Keep this high: a campus shares one
# NAT address, so students signing in together must not be locked out.
LOGIN_RATE_WINDOW_MS=900000
LOGIN_RATE_MAX=100
